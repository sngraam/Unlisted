# Optional Python backend URL; the current workspace uses same-origin Next.js server routes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Runtime/API connection. For Vercel + Supabase use the transaction pooler on port 6543.
# Never prefix database variables with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.project-ref:replace_me@region.pooler.supabase.com:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require

# Prisma migration connection. Use the Supabase session pooler on port 5432.
DIRECT_URL=postgresql://postgres.project-ref:replace_me@region.pooler.supabase.com:5432/postgres?sslmode=require

# Keep the client-side pool small in serverless functions. Raise only after measuring.
DATABASE_POOL_MAX=1

# Exact browser origin, with no trailing slash. Used for mutation checks and secure cookies.
# On Vercel, replace with your deployment's HTTPS origin.
APP_ORIGIN=http://localhost:3000
