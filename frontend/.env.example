# Optional Python backend URL; the current workspace uses same-origin Next.js server routes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server/Prisma CLI only. Create this database with pgvector support before applying migrations.
# Copy to .env.local and replace the example username/password with local development credentials.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://listing_user:replace_me@localhost:5432/listing_agent?schema=public

# Exact browser origin, with no trailing slash. Used for mutation checks and secure cookies.
# On Vercel, replace with your deployment's HTTPS origin.
APP_ORIGIN=http://localhost:3000
